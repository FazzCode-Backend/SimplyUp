<!DOCTYPE html>
<html lang="id" data-bs-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FazzDeploy - Modern Instant Deployment</title>
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;600;800&display=swap" rel="stylesheet">
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css"/>
    
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
    
    <style>
        :root {
            --primary-gradient: linear-gradient(135deg, #6366f1 0%, #a855f7 100%);
            --glass-bg: rgba(255, 255, 255, 0.03);
            --transition-speed: 0.4s;
        }

        [data-bs-theme="dark"] {
            --bg-body: #080c14;
            --card-bg: rgba(15, 23, 42, 0.75);
            --text-main: #f8fafc;
            --border-color: rgba(255, 255, 255, 0.08);
            --nav-bg: rgba(8, 12, 20, 0.9);
        }

        [data-bs-theme="light"] {
            --bg-body: #f1f5f9;
            --card-bg: rgba(255, 255, 255, 0.85);
            --text-main: #0f172a;
            --border-color: rgba(0, 0, 0, 0.05);
            --nav-bg: rgba(241, 245, 249, 0.9);
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: var(--bg-body);
            color: var(--text-main);
            overflow-x: hidden;
        }

        .video-wrapper {
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            z-index: -2; overflow: hidden;
        }
        .video-background {
            width: 100%; height: 100%; object-fit: cover;
            filter: blur(2px) brightness(0.4);
        }
        .video-overlay {
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background: radial-gradient(circle at center, transparent 0%, var(--bg-body) 90%);
            z-index: -1;
        }

        .glass-card {
            background: var(--card-bg);
            backdrop-filter: blur(20px);
            border: 1px solid var(--border-color);
            border-radius: 28px;
            padding: 2.5rem;
            transition: 0.3s ease;
        }
        @media (max-width: 768px) { .glass-card { padding: 1.5rem; } }

        .navbar { backdrop-filter: blur(20px); background: var(--nav-bg); border-bottom: 1px solid var(--border-color); }
        .navbar-brand { font-weight: 800; background: var(--primary-gradient); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }

        .btn-modern { padding: 14px 28px; border-radius: 16px; font-weight: 600; transition: 0.3s; }
        .btn-primary-glow { background: var(--primary-gradient); color: white !important; border: none; box-shadow: 0 8px 25px -5px rgba(99, 102, 241, 0.5); }
        .btn-primary-glow:hover { transform: translateY(-3px); box-shadow: 0 12px 30px -5px rgba(99, 102, 241, 0.7); }

        .gradient-text { background: var(--primary-gradient); -webkit-background-clip: text; -webkit-text-fill-color: transparent; font-weight: 800; }
        .dev-avatar { width: 80px; height: 80px; border-radius: 50%; border: 3px solid #6366f1; padding: 3px; margin-bottom: 1rem; }
        .upload-area { border: 2px dashed var(--border-color); border-radius: 20px; padding: 40px 20px; background: rgba(255,255,255,0.02); cursor: pointer; transition: 0.3s; }
        .upload-area:hover { border-color: #6366f1; background: rgba(99, 102, 241, 0.05); }
        .theme-toggle { width: 44px; height: 44px; border-radius: 12px; display: flex; align-items: center; justify-content: center; background: var(--glass-bg); border: 1px solid var(--border-color); cursor: pointer; }
    </style>
</head>

<body>
    <div class="video-wrapper">
        <video autoplay muted loop playsinline class="video-background">
            <source src="https://files.catbox.moe/w6oow2.mp4" type="video/mp4">
        </video>
    </div>
    <div class="video-overlay"></div>

    <nav class="navbar navbar-expand-lg fixed-top">
        <div class="container">
            <a class="navbar-brand fs-3" href="/">
                <i class="fa-solid fa-arrow-up-from-bracket me-2"></i>Simply<span class="fw-extrabold">Up</span>
            </a>
            <div class="d-flex align-items-center ms-auto me-3 order-lg-last">
                <div class="theme-toggle shadow-sm" id="themeSwitcher">
                    <i class="fa-solid fa-moon text-info" id="themeIcon"></i>
                </div>
            </div>
            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <i class="fa-solid fa-bars-staggered"></i>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto align-items-center py-3 py-lg-0">
                    <li class="nav-item"><a class="nav-link px-3" href="#deploy">Deploy</a></li>
                    <li class="nav-item"><a class="nav-link px-3" href="#pengembang">Pengembang</a></li>
                    <li class="nav-item"><a class="nav-link px-3" href="#donasi">Donasi</a></li>
                </ul>
            </div>
        </div>
    </nav>

    <section class="min-vh-100 d-flex align-items-center pt-5">
        <div class="container text-center" data-aos="fade-up">
            <h1 class="display-2 fw-bolder mb-4">Deploy Sekejap,<br><span class="gradient-text">Tanpa Ribet.</span></h1>
            <p class="lead opacity-75 mb-5 mx-auto" style="max-width: 650px;">
                Ubah file HTML Anda menjadi website live hanya dalam hitungan detik. Gratis dan cepat.
            </p>
            <div class="d-flex flex-column flex-sm-row justify-content-center gap-3">
                <a href="#deploy" class="btn btn-modern btn-primary-glow px-5">Mulai Sekarang</a>
                <a href="#donasi" class="btn btn-modern btn-outline-light px-5">Dukung Kami</a>
            </div>
        </div>
    </section>

    <section id="deploy" class="py-5">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-lg-8" data-aos="zoom-in">
                    <div class="glass-card shadow-lg">
                        <form id="deployForm">
                            <div class="mb-5 text-center">
                                <h2 class="fw-bold">Siapkan Project Anda</h2>
                                <p class="opacity-50">Isi subdomain dan upload file index.html</p>
                            </div>

                            <div class="mb-4">
                                <label class="form-label fw-bold small opacity-75">SUBDOMAIN</label>
                                <div class="input-group input-group-lg">
                                    <input type="text" class="form-control border-end-0 bg-transparent" id="webName" name="webName" placeholder="fazzcode" required>
                                    <span class="input-group-text bg-transparent opacity-50">.vercel.app</span>
                                </div>
                            </div>

                            <div class="mb-4 text-center">
                                <div class="upload-area" id="dropZone">
                                    <i class="fa-solid fa-file-arrow-up fs-1 gradient-text mb-3"></i>
                                    <h5 id="fileNameDisplay" class="fw-bold text-truncate px-3">Tarik file HTML ke sini</h5>
                                    <p class="small opacity-50 mb-0">Atau klik untuk memilih file</p>
                                    <input type="file" id="htmlFile" name="htmlFile" hidden accept=".html" onchange="handleFileSelect(this)">
                                </div>
                            </div>

                            <div id="previewSection" class="mb-4 animate__animated animate__fadeIn" style="display: none;">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="badge bg-success bg-opacity-10 text-success">Live Preview</span>
                                    <button type="button" class="btn btn-sm text-danger border-0" onclick="resetFile()"><i class="fa-solid fa-trash me-1"></i>Hapus</button>
                                </div>
                                <div class="rounded-4 overflow-hidden border border-secondary border-opacity-25 bg-white">
                                    <iframe id="htmlPreview" class="w-100" style="height: 250px; border:none;"></iframe>
                                </div>
                            </div>

                            <div class="mb-4 d-flex justify-content-center">
                                <div class="cf-turnstile" data-sitekey="<%= turnstileSiteKey %>" data-theme="dark"></div>
                            </div>

                            <button type="submit" class="btn btn-modern btn-primary-glow w-100 py-3 fs-5" id="deployBtn">
                                <i class="fa-solid fa-paper-plane me-2"></i> Deploy Website Sekarang
                            </button>

                            <div class="progress mt-4 rounded-pill d-none" id="progressBar" style="height: 10px;">
                                <div class="progress-bar progress-bar-striped progress-bar-animated bg-primary" id="progressFill" style="width: 0%"></div>
                            </div>
                            <div id="statusMessage" class="mt-4 text-center"></div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section id="pengembang" class="py-5 bg-black bg-opacity-20">
        <div class="container">
            <div class="text-center mb-5" data-aos="fade-up">
                <h2 class="fw-bold">Tim <span class="gradient-text">Pengembang</span></h2>
                <p class="opacity-50">Mereka yang meramu kode di balik layar.</p>
            </div>
            <div class="row g-4 justify-content-center">
                <div class="col-md-5 col-lg-4" data-aos="fade-up">
                    <div class="glass-card text-center h-100">
                        <img src="https://raw.githubusercontent.com/FazzCode-Backend/database/refs/heads/main/img/logo/20260104_195939.jpg" class="dev-avatar">
                        <h4 class="fw-bold">FazzCode</h4>
                        <p class="text-primary small mb-3">Pengembang</p>
                        <p class="small opacity-75">Bertanggung jawab atas kelancaran sistem deployment dan infrastruktur.</p>
                        <a href="https://trakteer.id/fazzcodex" target="_blank" class="btn btn-modern btn-primary-glow px-4 py-2 mt-3">
                            Follow My Sosmed
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section id="donasi" class="py-5">
        <div class="container text-center">
            <div class="glass-card" data-aos="zoom-in-up">
                <h2 class="fw-bold mb-4">Dukung <span class="gradient-text">Server Kami</span></h2>
                <p class="opacity-75 mb-5 mx-auto" style="max-width: 600px;">
                    Layanan ini sepenuhnya gratis. Donasi Anda melalui Trakteer sangat membantu, agar saya semangat dalam mengembangkan tools tools gratis.
                </p>
                <a href="https://trakteer.id/fazzcodex" target="_blank" class="btn btn-modern btn-primary-glow px-5 py-3">
                    <i class="fa-solid fa-heart me-2"></i> Donasi di Trakteer
                </a>
            </div>
        </div>
    </section>

    <footer class="py-5 text-center border-top border-secondary border-opacity-10">
        <p class="small opacity-50 mb-0">&copy; 2025, SimplyUp. Mempermudah</p>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script src="/socket.io/socket.io.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>

    <script>
        AOS.init({ duration: 800, once: true });
        const socket = io();

        const themeSwitcher = document.getElementById('themeSwitcher');
        const themeIcon = document.getElementById('themeIcon');
        const htmlTag = document.documentElement;

        themeSwitcher.addEventListener('click', () => {
            const currentTheme = htmlTag.getAttribute('data-bs-theme');
            const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
            htmlTag.setAttribute('data-bs-theme', newTheme);
            themeIcon.className = newTheme === 'dark' ? 'fa-solid fa-moon text-info' : 'fa-solid fa-sun text-warning';
        });

        const dropZone = document.getElementById('dropZone');
        const fileInput = document.getElementById('htmlFile');
        const fileNameDisplay = document.getElementById('fileNameDisplay');
        const previewSection = document.getElementById('previewSection');

        dropZone.onclick = () => fileInput.click();

        function handleFileSelect(input) {
            const file = input.files[0];
            if (file) {
                fileNameDisplay.innerText = file.name;
                const reader = new FileReader();
                reader.onload = e => {
                    document.getElementById('htmlPreview').srcdoc = e.target.result;
                    previewSection.style.display = 'block';
                };
                reader.readAsText(file);
            }
        }

        function resetFile() {
            fileInput.value = "";
            fileNameDisplay.innerText = "Tarik file HTML ke sini";
            previewSection.style.display = 'none';
        }

        const form = document.getElementById('deployForm');
        const deployBtn = document.getElementById('deployBtn');
        const statusMsg = document.getElementById('statusMessage');
        const pBar = document.getElementById('progressBar');
        const pFill = document.getElementById('progressFill');

        socket.on('deployStatus', (data) => {
            if (data.status === 'processing') {
                pBar.classList.remove('d-none');
                pFill.style.width = '70%';
                statusMsg.innerHTML = `<div class="alert alert-info border-0 py-2"><i class="fa-solid fa-sync fa-spin me-2"></i>${data.message}</div>`;
            } else if (data.status === 'success') {
                pFill.style.width = '100%';
                confetti({ particleCount: 150, spread: 70, origin: { y: 0.6 } });
                statusMsg.innerHTML = `<div class="alert alert-success mt-3 animate__animated animate__tada">Berhasil! Link: <a href="${data.url}" target="_blank" class="text-decoration-none fw-bold">${data.url}</a></div>`;
                deployBtn.disabled = false;
                deployBtn.innerHTML = '<i class="fa-solid fa-paper-plane me-2"></i> Deploy Website Sekarang';
                if (typeof turnstile !== 'undefined') turnstile.reset();
            }
        });

        form.onsubmit = async (e) => {
            e.preventDefault();
            
            // Validasi Turnstile sebelum kirim
            const turnstileResponse = document.querySelector('[name="cf-turnstile-response"]').value;
            if (!turnstileResponse) {
                statusMsg.innerHTML = `<div class="alert alert-warning border-0 py-2">Wajib isi captcha dulu bos!</div>`;
                return;
            }

            deployBtn.disabled = true;
            deployBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Connecting...';
            
            const formData = new FormData(form);
            try {
                await fetch(`/deploy?socketId=${socket.id}`, { method: 'POST', body: formData });
            } catch (err) {
                statusMsg.innerHTML = `<div class="alert alert-danger">${err.message}</div>`;
                deployBtn.disabled = false;
                if (typeof turnstile !== 'undefined') turnstile.reset();
            }
        };
    </script>
</body>
</html>
